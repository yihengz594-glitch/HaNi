# 复制为 .env.local，仅在服务端部署，不要放进小程序目录、Git 或日志。
PAYMENT_MODE=mock
PORT=3000
DATABASE_URL=
DATABASE_SSL=false
SESSION_TTL_DAYS=30

# 管理后台首次初始化时创建管理员（迁移005完成后配置并启动一次）。
# 请通过部署平台密钥管理设置真实值；首次创建后可移除这两项。
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_HOURS=8
ADMIN_ORIGIN=https://api.example.com

# 微信小程序与普通商户绑定信息
WX_APPID=wx_replace_me
WX_SECRET=replace_me
WX_MCHID=replace_me
WX_NOTIFY_URL=https://api.example.com/api/pay/notify
WX_API_HOST=https://api.mch.weixin.qq.com

# API v3 安全配置：使用密钥管理服务或服务端文件挂载，不要提交私钥内容。
WX_API_V3_KEY=replace_me
WX_MCH_CERT_SERIAL_NO=replace_me
WX_MCH_PRIVATE_KEY_PATH=/run/secrets/apiclient_key.pem
WX_PAY_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechatpay_public_key.pem
WX_PAY_PLATFORM_SERIAL_NO=replace_me

# 运行环境必须使用 HTTPS；小程序 request 合法域名也必须配置同一个域名。
API_PUBLIC_BASE_URL=https://api.example.com

# 人工真人 Q 版服务：默认关闭。商业规则确认前只能设 test 并在 /admin 授予测试账号。
CUSTOM_SERVICE_MODE=disabled
# 未确定单价时留空：测试账号免扣次；正式模式要求明确正整数与商业规则审批。
CUSTOM_CREDIT_COST=
CUSTOM_COMMERCIAL_RULES_APPROVED=false
CUSTOM_PERMANENT_POLICY=excluded
CUSTOM_LEGACY_MEMBER_POLICY=excluded
CUSTOM_DELIVERY_DAYS=7
CUSTOM_INCLUDED_REVISIONS=1
CUSTOM_RETENTION_DAYS=30
CUSTOM_ORDER_TIMEOUT_DAYS=60
# 私有持久化挂载卷的绝对路径；必须在仓库/public/tmp 之外，目录权限 0700，定期备份。
CUSTOM_STORAGE_ROOT=
