page { background: #f8f7f4; color: #25211d; }
.custom-page { box-sizing: border-box; min-height: 100vh; padding: 30rpx 26rpx calc(80rpx + env(safe-area-inset-bottom)); }
.custom-head { padding: 22rpx 8rpx 28rpx; }
.eyebrow { color: #a97a4c; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { font-size: 42rpx; font-weight: 800; line-height: 1.35; margin: 10rpx 0; }
.title-small { font-size: 30rpx; font-weight: 700; margin-bottom: 14rpx; }
.muted { color: #7f7770; font-size: 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.custom-card { padding: 28rpx; border-radius: 24rpx; background: #fff; margin-bottom: 22rpx; box-shadow: 0 9rpx 24rpx rgba(39,30,21,.055); font-size: 27rpx; line-height: 1.7; }
.custom-card > view + view { margin-top: 8rpx; }
.upload-box { height: 350rpx; border: 2rpx dashed #d8cbc0; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; color: #8d7771; background: #fcfaf8; margin-top: 20rpx; overflow: hidden; }
.upload-box image { width: 100%; height: 100%; }
.field { margin: 24rpx 0; }
.field > view:first-child { font-weight: 600; margin-bottom: 7rpx; }
.field input, .field textarea, textarea { box-sizing: border-box; width: 100%; border: 1rpx solid #e6e0d9; border-radius: 14rpx; background: #fcfbfa; padding: 16rpx; font-size: 27rpx; }
.field textarea, textarea { min-height: 140rpx; }
.confirm-row, .row, .file-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.confirm-row { padding: 18rpx 0; border-top: 1rpx solid #eee8e2; }
.confirm-row text { flex: 1; font-size: 25rpx; }
.primary, .secondary { box-sizing: border-box; border-radius: 16rpx; padding: 18rpx 24rpx; text-align: center; margin: 14rpx 0; font-size: 27rpx; line-height: 1.6; }
.primary { background: #25211d; color: white; }
.secondary { background: #f4f0eb; color: #332b25; }
button[disabled] { opacity: .45; }
.status { color: #995e43; font-weight: 700; flex-shrink: 0; }
.order-item .row .title-small { flex: 1; min-width: 0; }
.unread { color: #d46d61; font-size: 24rpx; }
.link { color: #2873a6; padding: 8rpx; flex-shrink: 0; font-size: 24rpx; }
.file-row { border-top: 1rpx solid #eee8e2; padding: 13rpx 0; }
.file-row text { flex: 1; }
.message { padding: 19rpx; background: #f8f5f2; border-radius: 15rpx; margin: 15rpx 0; }
.merchant-message { background: #f1f4f7; }
.message-head { color: #89817a; font-size: 21rpx; margin-bottom: 5rpx; }
