<view class="custom-page">
  <view wx:if="{{loading}}" class="custom-card">正在加载工单…</view>
  <view wx:elif="{{!order}}" class="custom-card">工单不存在或无权访问</view>
  <view wx:else>
    <view class="custom-head"><view class="eyebrow">{{merchant ? '商家工作台' : '我的人工定制'}}</view><view class="title">{{order.statusLabel}}</view><view class="muted">工单 {{order.id}}</view></view>
    <view class="custom-card"><view class="title-small">定制需求</view><view>人数：{{order.requirements.persons}} · 风格：{{order.requirements.style}}</view><view>保留特征：{{order.requirements.features}}</view><view>尺寸：{{order.requirements.size}}</view><view wx:if="{{order.requirements.notes}}">补充：{{order.requirements.notes}}</view><view class="muted">{{order.billingMode === 'CREDITS' ? '本单预占/结算' : '测试免扣'}} {{order.creditCost}} 次 · 已修改 {{order.revisionCount}} 次</view></view>
    <view class="custom-card"><view class="title-small">原图与交付文件</view>
      <view class="file-row" data-id="{{order.sourceFileId}}"><text>客户原始照片</text><view class="link" data-id="{{order.sourceFileId}}" bindtap="previewFile">查看</view><view class="link" data-id="{{order.sourceFileId}}" bindtap="saveFile">保存高清</view></view>
      <view wx:if="{{order.previewFileId}}" class="file-row"><text>Q图预览</text><view class="link" data-id="{{order.previewFileId}}" bindtap="previewFile">查看</view><view class="link" data-id="{{order.previewFileId}}" bindtap="saveFile">保存高清</view></view>
      <view wx:if="{{order.finalQFileId}}" class="file-row"><text>最终Q图</text><view class="link" data-id="{{order.finalQFileId}}" bindtap="previewFile">查看</view><view class="link" data-id="{{order.finalQFileId}}" bindtap="saveFile">保存高清</view></view>
      <view wx:if="{{order.patternFileId}}" class="file-row"><text>高清施工图</text><view class="link" data-id="{{order.patternFileId}}" bindtap="previewFile">查看</view><view class="link" data-id="{{order.patternFileId}}" bindtap="saveFile">保存高清</view></view>
      <view wx:if="{{order.colorsFileId}}" class="file-row"><text>用色清单</text><view class="link" data-id="{{order.colorsFileId}}" bindtap="previewFile">查看</view><view class="link" data-id="{{order.colorsFileId}}" bindtap="saveFile">保存高清</view></view>
    </view>
    <view wx:if="{{!merchant && order.status === 'PENDING_ACCEPT'}}" class="custom-card"><button class="secondary" data-action="cancel" bindtap="runAction" disabled="{{busy}}">取消工单并释放预占</button></view>
    <view wx:if="{{merchant && order.status === 'PENDING_ACCEPT'}}" class="custom-card"><button class="primary" data-action="accept" bindtap="runAction" disabled="{{busy}}">接单并开始制作</button></view>
    <view wx:if="{{merchant && (order.status === 'IN_PROGRESS' || order.status === 'REVISION')}}" class="custom-card"><view class="title-small">上传Q图预览</view><view class="secondary" data-kind="Q_PREVIEW" bindtap="uploadAsset">选择Q图预览 {{previewId ? '✓' : ''}}</view><button class="primary" data-action="preview" bindtap="runAction" disabled="{{busy || !previewId}}">发布Q图供客户确认</button></view>
    <view wx:if="{{!merchant && order.status === 'WAIT_Q_CONFIRM'}}" class="custom-card"><view class="title-small">请确认Q图预览</view><button class="primary" data-action="approve" bindtap="runAction" disabled="{{busy}}">确认Q图，等待图纸</button><view class="field"><view>修改意见</view><input value="{{reason}}" bindinput="onReasonInput" placeholder="请描述具体修改内容" /></view><button class="secondary" data-action="revise" bindtap="runAction" disabled="{{busy}}">提出修改</button></view>
    <view wx:if="{{merchant && order.status === 'WAIT_DELIVERY'}}" class="custom-card"><view class="title-small">交付三份高清文件</view><view class="secondary" data-kind="Q_FINAL" bindtap="uploadAsset">最终Q图 {{finalQId ? '✓' : ''}}</view><view class="secondary" data-kind="PATTERN" bindtap="uploadAsset">高清施工图 {{patternId ? '✓' : ''}}</view><view class="secondary" data-kind="COLORS" bindtap="uploadAsset">用色清单图片 {{colorsId ? '✓' : ''}}</view><button class="primary" data-action="deliver" bindtap="runAction" disabled="{{busy || !finalQId || !patternId || !colorsId}}">确认全部可见并完成交付</button></view>
    <view wx:if="{{merchant && order.status !== 'COMPLETED' && order.status !== 'CANCELLED' && order.status !== 'REJECTED' && order.status !== 'SYSTEM_FAILED'}}" class="custom-card"><view class="title-small">无法继续制作或上传失败？</view><view class="field"><view>拒单/终止原因（必填）</view><input value="{{reason}}" bindinput="onReasonInput" /></view><button class="secondary" data-action="reject" bindtap="runAction" disabled="{{busy}}">拒单并释放预占次数</button></view>
    <view class="custom-card"><view class="title-small">工单沟通</view><view class="muted">只在此工单内交流；进入页面刷新，每20秒适度更新。</view>
      <view wx:for="{{messages}}" wx:key="id" class="message {{item.sender_role === 'MERCHANT' ? 'merchant-message' : ''}}"><view class="message-head">{{item.sender_role === 'MERCHANT' ? '商家' : '客户'}} · {{item.created_at}}</view><view wx:if="{{item.body}}">{{item.body}}</view><view wx:if="{{item.file_id}}" class="link" data-id="{{item.file_id}}" bindtap="previewFile">查看聊天原图</view></view>
      <view wx:if="{{order.status !== 'COMPLETED' && order.status !== 'CANCELLED' && order.status !== 'REJECTED' && order.status !== 'SYSTEM_FAILED'}}"><textarea maxlength="2000" placeholder="输入消息" value="{{messageText}}" bindinput="onTextInput" /><view wx:if="{{pendingChatFileId}}" class="muted">图片已上传，待发送</view><view class="row"><button class="secondary" bindtap="attachChatImage" disabled="{{busy}}">发图片</button><button class="primary" bindtap="sendMessage" disabled="{{busy}}">发送文字/图片</button></view></view>
    </view>
  </view>
</view>
