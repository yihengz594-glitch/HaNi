}

.orb-purple {
  right: 0;
  bottom: 0;
  width: 140rpx;
  height: 140rpx;
  background: rgba(125, 84, 182, 0.54);
}

.orb-green {
  right: 88rpx;
  bottom: 48rpx;
  width: 86rpx;
  height: 86rpx;
  background: rgba(63, 177, 126, 0.62);
}

.orb-blue {
  right: 118rpx;
  bottom: -12rpx;
  width: 68rpx;
  height: 68rpx;
  background: rgba(77, 132, 218, 0.7);
}

.plan-head {
  margin-top: 34rpx;
}

.plan-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.plan-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 114rpx;
  box-sizing: border-box;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e1e4ea;
  border-radius: 20rpx;
  background: #ffffff;
}

.plan-name {
  color: #252830;
  font-size: 28rpx;
  font-weight: 800;
}

.plan-badge {
  margin-left: 8rpx;
  padding: 5rpx 9rpx;
  border-radius: 10rpx;
  color: #5d4aa3;
  background: #f0ecff;
  font-size: 17rpx;
  font-weight: 700;
}

.plan-description {
  margin-top: 7rpx;
  color: #969ca6;
  font-size: 20rpx;
}

.plan-action {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  border-radius: 14rpx;
  color: #556fae;
  background: #edf1fa;
  font-size: 20rpx;
  font-weight: 800;
}

.recent-work-item {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  margin-top: 16rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: #f4f5f7;
}

.recent-work-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin-right: 14rpx;
  border-radius: 16rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #526fc5, #7956b1);
  font-size: 29rpx;
}

.recent-work-name {
  color: #30343c;
  font-size: 24rpx;
  font-weight: 800;
}

.recent-work-meta {
  margin-top: 6rpx;
  color: #969ca6;
  font-size: 19rpx;
}

.recent-work-arrow {
  margin-left: auto;
  color: #8c94a1;
  font-size: 38rpx;
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  height: calc(118rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  padding-top: 16rpx;
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1rpx solid #e7e9ed;
  background: rgba(255, 255, 255, 0.97);
}

.nav-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  width: 25%;
  color: #969ba4;
}

.nav-icon {
  height: 42rpx;
  color: #8e939b;
  font-size: 30rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.nav-label {
  margin-top: 5rpx;
  font-size: 19rpx;
}

.nav-item.active .nav-label,
.nav-item.active .nav-icon {
  color: #1a1b20;
}

.nav-item.active .nav-icon-purple { color: #7257b3; }
.nav-item.active .nav-icon-blue { color: #4b78d4; }
.nav-item.active .nav-icon-green { color: #36a77a; }
.nav-item.active .nav-icon-black { color: #18191d; }

