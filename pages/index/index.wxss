.hero-image-caption {
  right: 20rpx;
  bottom: 18rpx;
  left: 20rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.hero-stats {
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-stat {
