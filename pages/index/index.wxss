.app-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 150rpx;
  background: #f3f4f6;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 112rpx;
  box-sizing: border-box;
  padding: 0 30rpx;
  background: #ffffff;
}

.topbar-title {
  color: #16171b;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.topbar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 58rpx;
  box-sizing: border-box;
  padding: 0 22rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  color: #202126;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.tab-panel {
  padding: 28rpx 28rpx 46rpx;
}

.hero-card {
  position: relative;
  min-height: 380rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 38rpx 34rpx;
  border-radius: 32rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #111216 0%, #15171e 45%, #293f70 100%);
  box-shadow: 0 18rpx 42rpx rgba(20, 25, 40, 0.2);
}

.hero-copy {
  position: relative;
  z-index: 2;
  width: 72%;
}

.hero-eyebrow,
.page-overline {
  color: #b7c9ff;
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 20rpx;
  color: #ffffff;
  font-size: 58rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.65;
}

.hero-pills {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  gap: 10rpx;
}

.hero-pill {
  padding: 10rpx 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 24rpx;
  color: #f1f4ff;
  background: rgba(255, 255, 255, 0.1);
  font-size: 20rpx;
}

.hero-orbit {
  position: absolute;
  border: 1rpx solid rgba(168, 183, 255, 0.2);
  border-radius: 50%;
}

.orbit-one {
  top: -100rpx;
  right: -90rpx;
  width: 390rpx;
  height: 390rpx;
}

.orbit-two {
  top: -42rpx;
  right: -32rpx;
  width: 270rpx;
  height: 270rpx;
  border-color: rgba(90, 213, 172, 0.2);
}

.hero-pixel-cluster {
  position: absolute;
  right: 50rpx;
  bottom: 62rpx;
  display: grid;
  grid-template-columns: repeat(3, 26rpx);
  gap: 10rpx;
  transform: rotate(-12deg);
}

.hero-pixel {
  width: 26rpx;
  height: 26rpx;
  border-radius: 8rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.18);
}

.pixel-blue { background: #5486d6; }
.pixel-purple { background: #9a6ed6; }
.pixel-green { background: #42b985; }
.pixel-white { background: #e7efff; }
.pixel-blue-light { background: #91c6ee; }
.pixel-black { background: #0d0e12; }
.pixel-purple-light { background: #c2a3ef; }
.pixel-green-light { background: #8ce1b8; }

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 34rpx 2rpx 18rpx;
}

.section-title {
  color: #17191e;
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.section-caption,
.recent-hint,
.section-count {
  color: #8a8f99;
  font-size: 22rpx;
}

.section-caption {
  margin-top: 8rpx;
}

.section-count {
  padding-bottom: 4rpx;
}

.style-grid,
.gallery-grid,
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.style-card,
.gallery-card,
.feature-card,
.recent-card,
.selected-image-card,
.settings-card-pro,
.result-card,
.make-tip-card,
.recent-work-card {
  box-sizing: border-box;
  border: 1rpx solid #e7e9ed;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(45, 53, 69, 0.06);
}

.style-card,
.gallery-card {
  padding: 12rpx;
}

.thumb-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  grid-template-rows: repeat(6, minmax(0, 1fr));
  height: 220rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f4f5f7;
}

.thumb-cell {
  min-width: 0;
  min-height: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.style-card-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8rpx;
  padding: 16rpx 6rpx 6rpx;
}

.style-name,
.gallery-name {
  color: #202228;
  font-size: 25rpx;
  font-weight: 800;
}

.style-description,
.gallery-meta {
  margin-top: 6rpx;
  color: #969ba5;
  font-size: 19rpx;
}

.style-tag {
  flex: 0 0 auto;
  padding: 7rpx 11rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: #1a1b20;
  font-size: 18rpx;
}

.home-cta {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(100deg, #15161a, #242d49);
  box-shadow: 0 12rpx 24rpx rgba(20, 25, 40, 0.18);
  font-size: 31rpx;
  font-weight: 800;
}

.cta-arrow {
  margin-left: 18rpx;
  color: #8cb9ff;
  font-size: 38rpx;
  font-weight: 400;
}

.mini-note {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 22rpx;
  color: #8f96a2;
  font-size: 21rpx;
}

.note-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #4abf91;
  box-shadow: 0 0 0 6rpx rgba(74, 191, 145, 0.12);
}

.page-intro {
  padding: 14rpx 4rpx 24rpx;
}

.page-overline {
  color: #6f78a8;
}

.page-title {
  margin-top: 12rpx;
  color: #16171b;
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #858b95;
  font-size: 25rpx;
}

.upload-card-pro {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 330rpx;
  box-sizing: border-box;
  border: 1rpx solid #e7e9ed;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(45, 53, 69, 0.08);
}

.upload-gradient-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  border-radius: 30rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #5d8fe2, #8054bd 55%, #40ad83);
  box-shadow: 0 14rpx 24rpx rgba(90, 113, 193, 0.28);
  font-size: 70rpx;
  font-weight: 200;
}

.upload-title-pro {
  margin-top: 22rpx;
  color: #17191e;
  font-size: 32rpx;
  font-weight: 800;
}

.upload-hint-pro {
  margin-top: 10rpx;
  color: #9499a3;
  font-size: 23rpx;
}

.selected-image-card {
  padding: 24rpx;
}

.selected-image-head,
.settings-head,
.recent-head,
.member-topline,
.mine-head,
.result-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.selected-label {
  color: #17191e;
  font-size: 29rpx;
  font-weight: 800;
}

.selected-sublabel {
  margin-top: 7rpx;
  color: #9298a1;
  font-size: 21rpx;
}

.image-status,
.palette-badge {
  padding: 9rpx 13rpx;
  border-radius: 16rpx;
  color: #267f60;
  background: #e8f7f0;
  font-size: 18rpx;
  font-weight: 800;
}

.image-preview {
  display: block;
  width: 100%;
  height: 430rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  background: #f4f5f7;
}

.image-actions {
  display: flex;
  margin-top: 18rpx;
  gap: 16rpx;
}

.secondary-button,
.outline-button,
.primary-small-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 74rpx;
  border-radius: 16rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.secondary-button {
  flex: 1;
  color: #4d5c82;
  background: #eef2fa;
}

.recent-card,
.settings-card-pro,
.result-card,
.make-tip-card,
.recent-work-card {
  margin-top: 22rpx;
  padding: 24rpx;
}

.recent-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  margin-top: 18rpx;
  border-radius: 18rpx;
  color: #9a9fa8;
  background: #f4f5f7;
  font-size: 24rpx;
}

.recent-empty-icon {
  margin-right: 12rpx;
  color: #766bc5;
  font-size: 28rpx;
}

.make-feature-head {
  margin-top: 34rpx;
}

.feature-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 230rpx;
  box-sizing: border-box;
  padding: 24rpx 14rpx;
  text-align: center;
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
}

.feature-icon-purple { background: linear-gradient(145deg, #8054bd, #4d78d4); }
.feature-icon-green { background: linear-gradient(145deg, #37a67a, #8fc448); }
.feature-icon-blue { background: linear-gradient(145deg, #4b78db, #58b4d6); }
.feature-icon-black { background: linear-gradient(145deg, #17181d, #455170); }

.feature-name {
  margin-top: 18rpx;
  color: #202228;
  font-size: 28rpx;
  font-weight: 800;
}

.feature-description {
  margin-top: 8rpx;
  color: #969ba5;
  font-size: 20rpx;
}

.setting-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.setting-name {
  color: #252830;
  font-size: 27rpx;
  font-weight: 800;
}

.setting-desc {
  color: #8d949e;
  font-size: 21rpx;
}

.size-options {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
  gap: 12rpx;
}

.mode-switch {
  display: flex;
  margin-top: 24rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f3f4f7;
}

.mode-item {
  flex: 1;
  height: 68rpx;
  border-radius: 14rpx;
  color: #8b9099;
  font-size: 23rpx;
  line-height: 68rpx;
  text-align: center;
}

.mode-item.active {
  color: #ef6b71;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(45, 53, 69, 0.08);
  font-weight: 800;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e1e4e9;
  border-radius: 18rpx;
  background: #ffffff;
}

.setting-row-action:active {
  background: #faf2f3;
}

.setting-row-label {
  color: #30343b;
  font-size: 25rpx;
  font-weight: 800;
}

.setting-row-hint {
  margin-top: 6rpx;
  color: #9ba0a8;
  font-size: 18rpx;
}

.setting-row-value {
  color: #ed7377;
  font-size: 25rpx;
  font-weight: 800;
  white-space: nowrap;
}

.setting-row-arrow {
  margin-left: 8rpx;
  color: #a7adb5;
  font-size: 30rpx;
  font-weight: 400;
}

.setting-grid-two {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.setting-grid-two .setting-row {
  min-width: 0;
  padding: 0 16rpx;
}

.setting-grid-two .setting-row-label,
.setting-grid-two .setting-row-value {
  font-size: 22rpx;
}

.setting-grid-two .setting-row-value {
  margin-left: 8rpx;
}

.size-option {
  flex: 1 0 20%;
  box-sizing: border-box;
  padding: 15rpx 8rpx;
  border: 1rpx solid #e1e5ec;
  border-radius: 14rpx;
  color: #697384;
  background: #ffffff;
  font-size: 22rpx;
  text-align: center;
}

.size-option.active {
  border-color: #4b70cb;
  color: #ffffff;
  background: linear-gradient(135deg, #202945, #526fc5);
  box-shadow: 0 8rpx 16rpx rgba(76, 105, 191, 0.2);
}

.primary-button,
.primary-small-button {
  color: #ffffff;
  background: linear-gradient(100deg, #15161a, #293962);
  box-shadow: 0 12rpx 24rpx rgba(28, 41, 79, 0.2);
}

.primary-button {
  width: 100%;
  height: 92rpx;
  box-sizing: border-box;
  margin-top: 22rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
}

.primary-button.disabled {
  opacity: 0.4;
  box-shadow: none;
}

.result-card-preload {
  position: absolute;
  left: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  min-height: 1rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  opacity: 0;
}

.canvas-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 24rpx 0 28rpx;
  padding: 16rpx;
  border-radius: 22rpx;
  background: #f1f3f6;
}

.canvas-shell-preload {
  width: 1rpx;
  height: 1rpx;
  margin: 0;
  padding: 0;
  overflow: hidden;
}

.pattern-canvas {
  width: 600rpx;
  height: 600rpx;
  border-radius: 14rpx;
  background: #ffffff;
}

.export-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
}

.result-meta {
  margin-top: 9rpx;
  color: #8b929d;
  font-size: 21rpx;
}

.result-card {
  overflow: hidden;
}

.tip-badge {
  flex: 0 0 auto;
  padding: 10rpx 14rpx;
  border-radius: 20rpx;
  color: #5d4aa3;
  background: #f0ecff;
  font-size: 19rpx;
  white-space: nowrap;
}

.view-switch {
  display: flex;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #f0f2f5;
}

.view-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
  color: #9298a2;
  font-size: 23rpx;
  line-height: 64rpx;
  text-align: center;
}

.view-tab.active {
  color: #2e427b;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(45, 53, 69, 0.08);
  font-weight: 800;
}

.legend-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.legend-title {
  color: #252830;
  font-size: 28rpx;
  font-weight: 800;
}

.legend-subtitle {
  color: #9298a2;
  font-size: 20rpx;
}

.legend-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  width: calc(50% - 8rpx);
  min-height: 58rpx;
  box-sizing: border-box;
  padding: 8rpx 10rpx;
  border-radius: 12rpx;
  background: #f6f7f9;
}

.swatch {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  flex: 0 0 auto;
}

.legend-main {
  min-width: 0;
}

.legend-name {
  color: #49546b;
  font-size: 22rpx;
  font-weight: 800;
}

.legend-hex {
  color: #a0a6af;
  font-size: 16rpx;
}

.legend-count {
  margin-left: auto;
  color: #5d6675;
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
}

.result-actions {
  display: flex;
  margin-top: 24rpx;
  gap: 16rpx;
}

.outline-button,
.primary-small-button {
  flex: 1;
}

.outline-button {
  border: 1rpx solid #bdc8e2;
  color: #4d639b;
  background: #ffffff;
}

.make-tip-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
}

.sheet-mask {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(18, 21, 28, 0.52);
}

.bottom-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 86vh;
  box-sizing: border-box;
  padding: 18rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -12rpx 40rpx rgba(20, 25, 35, 0.16);
}

.sheet-handle {
  width: 74rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 8rpx;
  background: #d9dce1;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.sheet-title {
  color: #252830;
  font-size: 31rpx;
  font-weight: 800;
}

.sheet-close {
  color: #9ba0a8;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 42rpx;
}

.sheet-size-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.sheet-size-option {
  height: 76rpx;
  border: 1rpx solid #f1f2f5;
  border-radius: 16rpx;
  color: #343840;
  background: #f8f9fb;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 76rpx;
  text-align: center;
}

.sheet-size-option.active {
  border-color: #f2767b;
  color: #ef6b71;
  background: #fff4f4;
}

.custom-size-title {
  margin-top: 24rpx;
  color: #30343b;
  font-size: 25rpx;
  font-weight: 800;
}

.custom-size-row {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.custom-input-wrap {
  display: flex;
  align-items: center;
  flex: 1;
  height: 76rpx;
  box-sizing: border-box;
  padding: 0 18rpx;
  border: 1rpx solid #dedfe3;
  border-radius: 16rpx;
  background: #fafbfc;
}

.custom-input-wrap text {
  color: #9ba0a8;
  font-size: 22rpx;
}

.custom-input-wrap input {
  flex: 1;
  margin-left: 18rpx;
  color: #343840;
  font-size: 29rpx;
  font-weight: 800;
  text-align: right;
}

.custom-size-x {
  width: 48rpx;
  color: #9ba0a8;
  font-size: 28rpx;
  text-align: center;
}

.sheet-confirm {
  height: 82rpx;
  margin-top: 20rpx;
  border-radius: 18rpx;
  color: #ffffff;
  background: linear-gradient(100deg, #ff7076, #f05b72);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 82rpx;
  text-align: center;
}

.sheet-list {
  max-height: 62vh;
  overflow-y: auto;
}

.sheet-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #f0f1f4;
  border-radius: 16rpx;
  background: #f8f9fb;
}

.sheet-list-item.active {
  border-color: #f2767b;
  background: #fff5f5;
}

.sheet-list-name {
  color: #343840;
  font-size: 26rpx;
  font-weight: 800;
}

.sheet-list-desc {
  margin-top: 6rpx;
  color: #9a9fa8;
  font-size: 20rpx;
}

.recommend-tag {
  margin-left: 10rpx;
  color: #ef6b71;
  font-size: 20rpx;
}

.sheet-check {
  color: #ef6b71;
  font-size: 32rpx;
  font-weight: 800;
}

.tip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  color: #ffffff;
