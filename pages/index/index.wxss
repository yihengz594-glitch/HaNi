}

.tip-description {
  margin-top: 7rpx;
  color: #969ca6;
  font-size: 20rpx;
  line-height: 1.5;
}

.filter-row {
  display: flex;
  gap: 14rpx;
}

.filter-pill {
  padding: 12rpx 24rpx;
  border: 1rpx solid #e1e4e9;
  border-radius: 24rpx;
