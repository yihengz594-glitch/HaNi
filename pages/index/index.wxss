}

.stat-value {
  color: #fffdfa;
  font-size: 26rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 5rpx;
  color: #a7a29b;
  font-size: 17rpx;
}

.inspiration-banner,
.gallery-feature-card {
  position: relative;
  overflow: hidden;
  height: 260rpx;
  margin-top: 22rpx;
  border-radius: 26rpx;
  background: #655e59;
  box-shadow: 0 14rpx 30rpx rgba(31, 27, 23, 0.1);
