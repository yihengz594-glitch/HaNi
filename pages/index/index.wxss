  color: rgba(255, 255, 255, 0.7);
  font-size: 22rpx;
  line-height: 1.6;
}

.member-art {
  position: absolute;
  right: 32rpx;
  bottom: -26rpx;
  width: 220rpx;
  height: 180rpx;
}

.member-orb {
  position: absolute;
  border-radius: 50%;
