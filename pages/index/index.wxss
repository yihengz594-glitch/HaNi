  box-shadow: 0 10rpx 22rpx rgba(32, 40, 63, 0.2);
  font-size: 34rpx;
  font-weight: 800;
}

.member-card {
  position: relative;
  min-height: 300rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 28rpx;
  border-radius: 30rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #15161a, #1d2230 62%, #263f65);
  box-shadow: 0 18rpx 36rpx rgba(22, 26, 39, 0.2);
}

.member-status {
  padding: 9rpx 16rpx;
  border-radius: 20rpx;
