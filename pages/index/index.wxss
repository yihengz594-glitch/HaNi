}

.filter-pill.active {
  border-color: #18191d;
  color: #ffffff;
  background: #18191d;
}

.gallery-grid {
  margin-top: 22rpx;
}

.gallery-thumb {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  grid-template-rows: repeat(6, minmax(0, 1fr));
  height: 280rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f4f5f7;
}

.gallery-name {
  padding: 14rpx 4rpx 0;
}

.gallery-meta {
  padding: 0 4rpx 7rpx;
}

.mine-head {
