}

/* Pinbead UI redesign v1
 * Visual-only layer. Existing class names, events and canvas styles are kept
 * so the generation, palette, export and payment flows remain untouched.
 */
page {
  background: #f7f5f2;
  color: #1f1b17;
}

.app-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fffdfa 0%, #f7f5f2 44%, #f3f0ec 100%);
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 24rpx 28rpx 18rpx;
  border-bottom: 1rpx solid rgba(226, 221, 215, 0.72);
  background: rgba(255, 253, 250, 0.94);
}

.topbar-title {
  color: #1f1b17;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.topbar-action {
  padding: 12rpx 22rpx;
  border: 1rpx solid #e2ddd7;
  border-radius: 999rpx;
  color: #655e59;
  background: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
}

.tab-panel {
  box-sizing: border-box;
  padding: 24rpx 24rpx 36rpx;
}

.hero-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  padding: 26rpx;
  border-radius: 30rpx;
  color: #fffdfa;
  background: #1f1b17;
  box-shadow: 0 20rpx 44rpx rgba(31, 27, 23, 0.18);
}

.hero-card::before {
  position: absolute;
  top: -120rpx;
  right: -86rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(244, 166, 185, 0.16);
  content: '';
}

.hero-topline,
.hero-stats,
.hero-pills,
.hero-brand,
.hero-live {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.hero-topline {
  justify-content: space-between;
}

.hero-brand {
  gap: 10rpx;
  color: #f5c84b;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  color: #1f1b17;
  background: #f5c84b;
  font-size: 22rpx;
}

.hero-live {
  gap: 8rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  color: #d9f3e6;
  background: rgba(85, 184, 135, 0.14);
  font-size: 18rpx;
}

.live-dot,
.hero-image-badge-dot,
.note-dot,
.gallery-note-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #55b887;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 530rpx;
  margin-top: 42rpx;
}

.hero-eyebrow,
.page-overline,
.section-kicker {
  color: #a7a29b;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1.5rpx;
}

.hero-title {
  margin-top: 12rpx;
  color: #fffdfa;
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: -3rpx;
  line-height: 1.1;
}

.hero-title-accent {
  color: #f4a6b9;
}

.hero-subtitle {
  margin-top: 18rpx;
  color: rgba(255, 253, 250, 0.7);
  font-size: 23rpx;
  line-height: 1.65;
}

.hero-pills {
  gap: 10rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.hero-pill {
  padding: 9rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  color: rgba(255, 253, 250, 0.82);
  background: rgba(255, 255, 255, 0.08);
  font-size: 17rpx;
}

.hero-art {
  position: relative;
  z-index: 1;
  height: 288rpx;
  overflow: hidden;
  margin-top: 26rpx;
  border: 6rpx solid rgba(255, 253, 250, 0.9);
  border-radius: 24rpx;
  background: #f4eee7;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-image-tint {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
