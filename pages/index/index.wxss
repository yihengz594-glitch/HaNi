.inspiration-image,
.gallery-feature-image {
  width: 100%;
  height: 100%;
}

.inspiration-overlay,
.gallery-feature-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(90deg, rgba(31, 27, 23, 0.78) 0%, rgba(31, 27, 23, 0.2) 72%, rgba(31, 27, 23, 0.08) 100%);
}

.inspiration-content,
.gallery-feature-content {
  position: absolute;
  z-index: 1;
  right: 28rpx;
  bottom: 24rpx;
  left: 28rpx;
  color: #fffdfa;
}

.inspiration-label,
.gallery-feature-label {
  color: #f5c84b;
  font-size: 17rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.inspiration-title,
.gallery-feature-title {
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.inspiration-subtitle,
.gallery-feature-subtitle {
  max-width: 500rpx;
  margin-top: 8rpx;
  color: rgba(255, 253, 250, 0.78);
  font-size: 18rpx;
  line-height: 1.5;
}

.inspiration-action,
.gallery-feature-action {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 14rpx;
  padding: 9rpx 16rpx;
  border: 1rpx solid rgba(255, 253, 250, 0.38);
  border-radius: 999rpx;
  color: #fffdfa;
  background: rgba(255, 253, 250, 0.1);
  font-size: 18rpx;
  font-weight: 700;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 32rpx;
}

.section-title {
  margin-top: 7rpx;
  color: #1f1b17;
  font-size: 30rpx;
  font-weight: 900;
  letter-spacing: -0.5rpx;
}

.section-caption,
.recent-hint,
.page-subtitle {
  margin-top: 6rpx;
  color: #8f8881;
  font-size: 19rpx;
  line-height: 1.45;
}

.section-count,
.payment-mode-label {
  color: #9b9289;
  font-size: 18rpx;
}

.style-grid,
.gallery-grid,
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.style-card,
.gallery-card,
.feature-card,
.recent-card,
.settings-card-pro,
.result-card,
.member-card,
.plan-card,
.recent-work-card,
.redeem-card {
  border: 1rpx solid #e8e3dd;
  background: #fffdfa;
  box-shadow: 0 8rpx 24rpx rgba(31, 27, 23, 0.05);
}

.style-card,
.gallery-card {
  overflow: hidden;
  border-radius: 22rpx;
}

.style-visual {
  position: relative;
  height: 210rpx;
  overflow: hidden;
  background: #f1ece6;
}

.style-image {
  width: 100%;
  height: 100%;
}

.style-image-overlay {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 45%;
  background: linear-gradient(180deg, rgba(31, 27, 23, 0) 0%, rgba(31, 27, 23, 0.56) 100%);
}

.style-serial,
.visual-chip,
.gallery-badge {
  position: absolute;
  z-index: 1;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  color: #fffdfa;
  background: rgba(31, 27, 23, 0.68);
  font-size: 16rpx;
  font-weight: 800;
}

.style-serial {
  top: 14rpx;
  left: 14rpx;
}

.visual-chip {
  right: 14rpx;
  top: 14rpx;
}

.style-sample-strip,
.style-thumb-grid {
  display: none;
}

.style-card-footer {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8rpx;
  padding: 16rpx 16rpx 18rpx;
}

.style-name,
.gallery-name,
.feature-name {
  color: #2a2521;
  font-size: 22rpx;
  font-weight: 800;
}

.style-description,
.gallery-meta,
.feature-description {
  margin-top: 5rpx;
  color: #9b9289;
  font-size: 17rpx;
}

.style-tag {
  flex: 0 0 auto;
  padding: 6rpx 10rpx;
  border-radius: 999rpx;
  color: #2f6faf;
  background: #e7f1fa;
  font-size: 16rpx;
  font-weight: 700;
}

.home-cta,
.primary-button,
.sheet-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 88rpx;
  margin-top: 24rpx;
  border-radius: 20rpx;
  color: #fffdfa;
  background: #1f1b17;
  box-shadow: 0 12rpx 26rpx rgba(31, 27, 23, 0.16);
  font-size: 25rpx;
  font-weight: 800;
}

.home-cta {
  justify-content: space-between;
  padding: 0 24rpx;
}

.cta-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  color: #1f1b17;
  background: #f5c84b;
}

.cta-arrow {
  font-size: 34rpx;
  font-weight: 400;
}

.mini-note,
.gallery-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  color: #9b9289;
  font-size: 18rpx;
}

.page-intro {
  padding: 12rpx 2rpx 0;
}

.page-title {
  margin-top: 8rpx;
  color: #1f1b17;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.studio-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 20rpx;
}

.studio-stat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border: 1rpx solid #e8e3dd;
  border-radius: 20rpx;
  background: #fffdfa;
}

.studio-stat-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.icon-purple { color: #6846a1; background: #efe8fb; }
.icon-green { color: #277959; background: #e5f5eb; }
.studio-stat-value { color: #2a2521; font-size: 19rpx; font-weight: 800; }
.studio-stat-label { margin-top: 4rpx; color: #9b9289; font-size: 16rpx; }

.upload-card-pro,
.selected-image-card,
.settings-card-pro,
.result-card,
.recent-card,
.make-tip-card {
  border: 1rpx solid #e8e3dd;
  border-radius: 24rpx;
  background: #fffdfa;
  box-shadow: 0 8rpx 24rpx rgba(31, 27, 23, 0.05);
}

.upload-card-pro {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 44rpx 24rpx 28rpx;
  text-align: center;
}

.upload-card-pro::before,
.upload-card-pro::after {
  position: absolute;
  width: 84rpx;
  height: 84rpx;
  border: 2rpx solid #f4a6b9;
  border-radius: 24rpx;
  content: '';
}

.upload-card-pro::before { top: -30rpx; left: -30rpx; transform: rotate(26deg); }
.upload-card-pro::after { right: -34rpx; bottom: -34rpx; transform: rotate(-18deg); border-color: #4e95d9; }
.upload-corner { display: none; }

.upload-gradient-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  margin: 0 auto;
  border-radius: 26rpx;
  color: #fffdfa;
  background: linear-gradient(135deg, #f4a6b9, #4e95d9);
  font-size: 50rpx;
  font-weight: 300;
  box-shadow: 0 12rpx 22rpx rgba(78, 149, 217, 0.22);
}

.upload-title-pro {
  margin-top: 20rpx;
  color: #2a2521;
  font-size: 28rpx;
  font-weight: 900;
}

.upload-hint-pro {
  margin-top: 8rpx;
  color: #9b9289;
  font-size: 19rpx;
}

.upload-footnote {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  color: #8f8881;
  font-size: 17rpx;
}

.selected-image-card {
  margin-top: 20rpx;
  padding: 18rpx;
}

.selected-image-head,
.settings-head,
.recent-head,
.result-heading,
.legend-title-row,
.member-topline,
.plan-head,
.plan-card,
.redeem-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.selected-label { color: #2a2521; font-size: 25rpx; font-weight: 900; }
.selected-sublabel { margin-top: 5rpx; color: #9b9289; font-size: 17rpx; }
.image-status { padding: 8rpx 14rpx; border-radius: 999rpx; color: #277959; background: #e6f6ed; font-size: 17rpx; font-weight: 800; }

.image-preview {
  display: block;
  width: 100%;
  height: 440rpx;
  margin-top: 16rpx;
  border-radius: 18rpx;
  background: #f4f0ec;
}

.image-actions,
.result-actions,
.redeem-modal-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.secondary-button,
.outline-button,
.primary-small-button {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.secondary-button,
.outline-button {
  color: #655e59;
  background: #f1ece6;
}

.primary-small-button {
  color: #fffdfa;
  background: #1f1b17;
}

.recent-card,
.settings-card-pro,
.result-card,
.make-tip-card {
  margin-top: 20rpx;
  padding: 20rpx;
}

.recent-empty {
  box-sizing: border-box;
  margin-top: 14rpx;
  padding: 36rpx 20rpx;
  border: 1rpx dashed #d8d0c8;
  border-radius: 18rpx;
  color: #9b9289;
  font-size: 18rpx;
  text-align: center;
}

.recent-empty-icon,
.tip-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 12rpx;
  border-radius: 14rpx;
  color: #fffdfa;
  background: #f4a6b9;
  font-size: 22rpx;
}

.make-feature-head { margin-top: 30rpx; }
.feature-card { padding: 18rpx; border-radius: 20rpx; }
.feature-index { color: #b9b1a9; font-size: 16rpx; font-weight: 800; }
.feature-icon { display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; margin-top: 20rpx; border-radius: 16rpx; font-size: 20rpx; font-weight: 900; }
.feature-icon-purple { color: #6846a1; background: #efe8fb; }
.feature-icon-green { color: #277959; background: #e5f5eb; }
.feature-icon-blue { color: #2f6faf; background: #e7f1fa; }
.feature-icon-black { color: #fffdfa; background: #1f1b17; }
.feature-name { margin-top: 14rpx; }

.settings-card-pro {
  margin-top: 20rpx;
}

.settings-head { align-items: flex-start; }
.palette-badge { padding: 9rpx 14rpx; border-radius: 999rpx; color: #277959; background: #e6f6ed; font-size: 17rpx; font-weight: 800; }
.mode-switch { display: flex; margin-top: 18rpx; padding: 5rpx; border-radius: 16rpx; background: #f1ece6; }
.mode-item { flex: 1; padding: 14rpx 8rpx; border-radius: 12rpx; color: #9b9289; font-size: 18rpx; text-align: center; }
.mode-item.active { color: #2f6faf; background: #fffdfa; box-shadow: 0 4rpx 12rpx rgba(31, 27, 23, 0.08); font-weight: 800; }
.setting-row { min-height: 78rpx; box-sizing: border-box; padding: 17rpx 0; }
.setting-row + .setting-row { border-top: 1rpx solid #eee9e3; }
.setting-grid-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 18rpx; }
.setting-grid-two .setting-row + .setting-row { border-top: 0; }
.setting-row-label { color: #332d28; font-size: 21rpx; font-weight: 800; }
.setting-row-hint { margin-top: 4rpx; color: #a7a29b; font-size: 16rpx; }
.setting-row-value { color: #e06f7f; font-size: 20rpx; font-weight: 800; }
.setting-row-arrow { color: #b9b1a9; font-size: 28rpx; font-weight: 400; }

.primary-button { width: 100%; border: 0; }
.primary-button.disabled { opacity: 0.45; }

.result-card-preload { padding-bottom: 20rpx; }
.result-heading { align-items: flex-start; }
.result-meta { margin-top: 6rpx; color: #9b9289; font-size: 17rpx; }
.tip-badge { padding: 9rpx 13rpx; border-radius: 999rpx; color: #6846a1; background: #efe8fb; font-size: 16rpx; font-weight: 700; }
.view-switch { display: flex; margin-top: 18rpx; padding: 5rpx; border-radius: 16rpx; background: #f1ece6; }
.view-tab { flex: 1; padding: 14rpx 8rpx; border-radius: 12rpx; color: #a7a29b; font-size: 19rpx; text-align: center; }
.view-tab.active { color: #2f6faf; background: #fffdfa; box-shadow: 0 4rpx 12rpx rgba(31, 27, 23, 0.08); font-weight: 800; }
.canvas-shell { display: flex; align-items: center; justify-content: center; overflow: hidden; min-height: 630rpx; margin-top: 18rpx; padding: 14rpx; border-radius: 20rpx; background: #f1ece6; }
.canvas-shell-preload { min-height: 320rpx; }
.pattern-canvas { width: 600rpx; height: 600rpx; border: 1rpx solid #d8d0c8; border-radius: 10rpx; background: #fffdfa; }
.export-canvas { position: absolute; left: -9999px; width: 1rpx; height: 1rpx; }
.legend-title-row { margin-top: 22rpx; }
.legend-title { color: #2a2521; font-size: 25rpx; font-weight: 900; }
.legend-subtitle { color: #9b9289; font-size: 17rpx; }
.legend-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 12rpx; }
.legend-item { display: flex; align-items: center; min-width: 0; padding: 12rpx; border-radius: 14rpx; background: #f7f3ef; }
.swatch { flex: 0 0 auto; width: 34rpx; height: 34rpx; border: 1rpx solid rgba(31, 27, 23, 0.12); border-radius: 10rpx; }
.legend-main { min-width: 0; margin-left: 9rpx; }
.legend-name { color: #332d28; font-size: 18rpx; font-weight: 800; }
.legend-hex { margin-top: 2rpx; color: #a7a29b; font-size: 14rpx; }
.legend-count { margin-left: auto; color: #8f8881; font-size: 14rpx; text-align: right; }
.make-tip-card { display: flex; align-items: center; gap: 14rpx; }
.make-tip-card .tip-icon { flex: 0 0 auto; margin: 0; }
.tip-title { color: #332d28; font-size: 21rpx; font-weight: 800; }
.tip-description { margin-top: 5rpx; color: #9b9289; font-size: 17rpx; line-height: 1.45; }

.gallery-intro { padding-bottom: 2rpx; }
.filter-row { display: flex; gap: 10rpx; margin-top: 20rpx; }
.filter-pill { padding: 10rpx 18rpx; border-radius: 999rpx; color: #8f8881; background: #eee9e3; font-size: 18rpx; }
.filter-pill.active { color: #fffdfa; background: #1f1b17; font-weight: 800; }
.gallery-feature-card { height: 290rpx; margin-top: 18rpx; }
.gallery-grid { margin-top: 20rpx; }
.gallery-thumb { position: relative; height: 210rpx; overflow: hidden; background: #f1ece6; }
.gallery-image { width: 100%; height: 100%; }
.gallery-badge { top: 14rpx; left: 14rpx; }
.gallery-name { padding: 14rpx 14rpx 0; }
.gallery-meta { padding: 0 14rpx 16rpx; }

.mine-panel { padding-top: 22rpx; }
.member-card { position: relative; overflow: hidden; box-sizing: border-box; padding: 24rpx; border: 0; border-radius: 26rpx; color: #fffdfa; background: #1f1b17; box-shadow: 0 18rpx 36rpx rgba(31, 27, 23, 0.18); }
.member-card::after { position: absolute; top: -58rpx; right: -64rpx; width: 190rpx; height: 190rpx; border-radius: 50%; background: rgba(244, 166, 185, 0.28); content: ''; }
.member-topline { position: relative; z-index: 1; }
.member-status { padding: 8rpx 14rpx; border-radius: 999rpx; color: #fffdfa; background: rgba(255, 253, 250, 0.16); font-size: 17rpx; font-weight: 700; }
.member-note { max-width: 360rpx; color: rgba(255, 253, 250, 0.68); font-size: 17rpx; text-align: right; }
.member-title { position: relative; z-index: 1; margin-top: 28rpx; font-size: 40rpx; font-weight: 900; }
.member-description { position: relative; z-index: 1; display: inline-block; margin-top: 14rpx; padding: 10rpx 14rpx; border-radius: 10rpx; color: rgba(255, 253, 250, 0.82); background: rgba(255, 253, 250, 0.1); font-size: 18rpx; }
.member-expiry { position: relative; z-index: 1; margin-top: 14rpx; color: #f5c84b; font-size: 18rpx; font-weight: 700; }
.member-features { position: relative; z-index: 1; display: flex; gap: 10rpx; margin-top: 18rpx; }
.member-features view { padding: 7rpx 11rpx; border: 1rpx solid rgba(255, 253, 250, 0.16); border-radius: 999rpx; color: rgba(255, 253, 250, 0.64); font-size: 15rpx; }
.member-art { position: absolute; right: 16rpx; bottom: 14rpx; width: 180rpx; height: 100rpx; }
.member-orb { position: absolute; border-radius: 50%; opacity: 0.84; }
.orb-purple { right: 20rpx; bottom: 10rpx; width: 74rpx; height: 74rpx; background: #6846a1; }
.orb-green { right: 88rpx; bottom: 20rpx; width: 48rpx; height: 48rpx; background: #55b887; }
.orb-blue { right: 70rpx; bottom: 60rpx; width: 32rpx; height: 32rpx; background: #4e95d9; }
.plan-head { align-items: flex-end; margin-top: 30rpx; }
.plan-head .section-caption { max-width: 370rpx; }
.payment-mode-label { max-width: 190rpx; line-height: 1.35; text-align: right; }
.plan-list { margin-top: 16rpx; }
.plan-card { gap: 14rpx; box-sizing: border-box; margin-top: 12rpx; padding: 18rpx; border-radius: 20rpx; }
.plan-card-featured { border-color: #f0c77d; background: #fffaf1; }
.plan-copy { min-width: 0; }
.plan-name { color: #2a2521; font-size: 25rpx; font-weight: 900; }
.plan-badge { display: inline-block; margin-left: 8rpx; padding: 5rpx 9rpx; border-radius: 999rpx; color: #8e5f22; background: #f7e3b6; font-size: 15rpx; vertical-align: middle; }
.plan-description { margin-top: 7rpx; color: #8f8881; font-size: 17rpx; }
.plan-purchase { flex: 0 0 auto; min-width: 160rpx; text-align: right; }
.plan-original-price { margin-bottom: 5rpx; color: #b9b1a9; font-size: 16rpx; text-decoration: line-through; }
.plan-price { color: #1f1b17; font-size: 29rpx; font-weight: 900; }
.mine-panel .plan-action { display: inline-block; min-width: 112rpx; margin-top: 10rpx; padding: 12rpx 20rpx; border-radius: 14rpx; color: #fffdfa; background: #1f1b17; font-size: 19rpx; font-weight: 800; text-align: center; }
.recent-work-card { margin-top: 20rpx; padding: 20rpx; border-radius: 22rpx; }
.recent-work-grid { gap: 12rpx; margin-top: 16rpx; }
.recent-work-tile { width: calc(33.333% - 8rpx); padding: 8rpx; border-radius: 16rpx; background: #f1ece6; }
.recent-work-preview { height: 150rpx; border-radius: 12rpx; background: #fffdfa; }
.recent-delete { background: rgba(31, 27, 23, 0.68); }
.recent-work-actions view { color: #2f6faf; background: #e7f1fa; }
.redeem-card { margin-top: 16rpx; padding: 20rpx; border-radius: 20rpx; }
.redeem-title { color: #2a2521; font-size: 22rpx; }
.redeem-caption { color: #9b9289; font-size: 16rpx; }
.redeem-button { padding: 11rpx 22rpx; border-radius: 14rpx; color: #fffdfa; background: #1f1b17; font-size: 19rpx; font-weight: 800; }

.bottom-nav { position: fixed; right: 18rpx; bottom: calc(18rpx + env(safe-area-inset-bottom)); left: 18rpx; z-index: 30; display: flex; justify-content: space-around; box-sizing: border-box; padding: 12rpx 8rpx 10rpx; border: 1rpx solid rgba(226, 221, 215, 0.9); border-radius: 24rpx; background: rgba(255, 253, 250, 0.94); box-shadow: 0 14rpx 34rpx rgba(31, 27, 23, 0.12); }
.nav-item { position: relative; flex: 1; color: #a7a29b; text-align: center; }
.nav-item.active { color: #1f1b17; font-weight: 800; }
.nav-icon { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; margin: 0 auto 5rpx; border-radius: 14rpx; color: #8f8881; background: #f1ece6; font-size: 20rpx; }
.nav-item.active .nav-icon { color: #fffdfa; background: #1f1b17; }
.nav-label { font-size: 16rpx; }
.nav-active-line { position: absolute; top: -12rpx; right: 38%; left: 38%; height: 5rpx; border-radius: 999rpx; background: #f4a6b9; }

.sheet-mask,
.redeem-mask { background: rgba(31, 27, 23, 0.48); backdrop-filter: blur(6rpx); }
.bottom-sheet { padding: 12rpx 24rpx 32rpx; border-radius: 30rpx 30rpx 0 0; background: #fffdfa; box-shadow: 0 -16rpx 40rpx rgba(31, 27, 23, 0.16); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 20rpx; border-radius: 999rpx; background: #d8d0c8; }
.sheet-title { color: #2a2521; font-size: 27rpx; font-weight: 900; }
.sheet-close { color: #9b9289; font-size: 36rpx; }
.sheet-size-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; margin-top: 20rpx; }
.sheet-size-option { padding: 20rpx 6rpx; border: 1rpx solid #e8e3dd; border-radius: 16rpx; color: #655e59; background: #fffdfa; font-size: 20rpx; text-align: center; }
.sheet-size-option.active { border-color: #4e95d9; color: #2f6faf; background: #e7f1fa; font-weight: 800; }
.sheet-list { margin-top: 16rpx; }
.sheet-list-item { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #eee9e3; }
.sheet-list-name { color: #332d28; font-size: 21rpx; font-weight: 800; }
.sheet-list-desc { margin-top: 5rpx; color: #9b9289; font-size: 17rpx; }
.sheet-list-item.active .sheet-list-name { color: #2f6faf; }
.sheet-check { color: #55b887; font-size: 26rpx; font-weight: 900; }
.custom-size-title { margin-top: 22rpx; color: #655e59; font-size: 18rpx; font-weight: 800; }
.custom-size-row { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.custom-input-wrap { display: flex; align-items: center; flex: 1; gap: 8rpx; padding: 0 14rpx; border: 1rpx solid #e2ddd7; border-radius: 14rpx; background: #f7f3ef; color: #9b9289; font-size: 17rpx; }
.custom-input-wrap input { flex: 1; height: 70rpx; color: #2a2521; font-size: 22rpx; }
.custom-size-x { color: #a7a29b; font-size: 22rpx; }
.sheet-confirm { min-height: 78rpx; margin-top: 20rpx; font-size: 22rpx; }
.redeem-modal { padding: 26rpx 22rpx 20rpx; border-radius: 26rpx; background: #fffdfa; box-shadow: 0 20rpx 58rpx rgba(31, 27, 23, 0.22); }
.redeem-modal-title { color: #2a2521; font-size: 29rpx; }
.redeem-modal-caption { color: #9b9289; font-size: 17rpx; }
.redeem-input { border-color: #e2ddd7; border-radius: 14rpx; background: #f7f3ef; }
.redeem-cancel { color: #655e59; background: #f1ece6; }
.redeem-confirm { color: #fffdfa; background: #1f1b17; }

/* 首页插画只作展示：移除旧风格卡片的选中装饰、遮罩和渐变。 */
.hero-image-tint,
.inspiration-overlay,
.style-image-overlay,
.gallery-feature-overlay {
  display: none;
}

.hero-image,
.inspiration-image {
  display: block;
  object-fit: contain;
  background: #fffdfa;
}

.inspiration-banner {
  display: flex;
  flex-direction: column;
  height: auto;
  min-height: 0;
  background: #fffdfa;
}

.inspiration-image {
  flex: 0 0 auto;
  height: 270rpx;
}

.inspiration-content {
  position: relative;
  right: auto;
  bottom: auto;
  left: auto;
  padding: 16rpx 20rpx 18rpx;
  color: #1f1b17;
  background: #fffdfa;
}

.inspiration-label {
  color: #b46a37;
}

.inspiration-title {
  color: #1f1b17;
}

.inspiration-subtitle {
  color: #8f8881;
}

.inspiration-action {
  border-color: #e2ddd7;
  color: #1f1b17;
  background: #f7f3ef;
}

.inspiration-action text {
  color: #2f6faf;
}

.inspiration-corner {
  display: none;
}

.illustration-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}

.illustration-card {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 224rpx;
  overflow: hidden;
  border: 1rpx solid #e8e3dd;
  border-radius: 22rpx;
  background: #fffdfa;
  box-shadow: 0 8rpx 24rpx rgba(31, 27, 23, 0.05);
}

.illustration-image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
  background: #fffdfa;
}

.style-card::after,
.gallery-card::after {
  display: none;
}

.app-shell {
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

.bottom-nav {
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  padding-bottom: 10rpx;
}

/* Final homepage treatment: original cream cat artwork, complete images, and one safe-area calculation. */
.manual-service-entry { display:flex; align-items:center; justify-content:space-between; gap:18rpx; padding:24rpx 28rpx; margin:22rpx 0; background:#fffaf3; border:1rpx solid #eadfce; border-radius:22rpx; }
.manual-service-title { font-size:29rpx; font-weight:700; color:#27221d; }
.manual-service-caption, .manual-service-status { margin-top:8rpx; font-size:23rpx; color:#786f66; line-height:1.5; }
.manual-service-status { color:#ae6957; }
.manual-service-arrow { flex-shrink:0; font-size:44rpx; color:#9b8170; }
.app-shell.safe-bottom {
  padding-bottom: calc(142rpx + env(safe-area-inset-bottom));
}

.hero-card {
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: visible;
  padding: 20rpx;
  border: 1rpx solid #eee7df;
  border-radius: 28rpx;
  color: #29251f;
  background: #fffdfa;
  box-shadow: 0 10rpx 30rpx rgba(48, 38, 24, 0.06);
}

.hero-art {
  position: relative;
  inset: auto;
  order: 0;
  display: block;
  width: 100%;
  height: auto;
  overflow: hidden;
  border-radius: 20rpx;
  background: #fff;
}

.hero-image {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  background: #fff;
}

.hero-copy {
  position: relative;
  inset: auto;
  order: 1;
  width: 100%;
  margin-top: 18rpx;
}

.hero-eyebrow { color: #a17d4d; font-size: 19rpx; }
.hero-title { margin-top: 7rpx; color: #28251f; font-size: 41rpx; }
.hero-subtitle { margin-top: 8rpx; color: #7c756c; font-size: 22rpx; line-height: 1.55; }
.hero-title-accent { color: #df8297; }

.gallery-guide-card {
  position: relative;
  display: block;
  width: 100%;
  height: auto;
  min-height: 0;
  overflow: hidden;
  padding: 0;
  border: 1rpx solid #ece5dc;
  border-radius: 22rpx;
  background: #fffdfa;
}

.gallery-guide-image {
  display: block;
  width: 100%;
  height: auto;
  object-fit: contain;
  background: #fff;
}

.illustration-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14rpx; }
.illustration-card {
  position: relative;
  height: 224rpx;
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #ebe5dd;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: none;
}
.illustration-card::before,
.illustration-card::after { display: none !important; content: none !important; }
.illustration-image { display: block; width: 100%; height: 100%; object-fit: contain; background: #fff; opacity: 1; filter: none; }
.home-image-state { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; padding: 14rpx; color: #8e867c; background: rgba(255, 253, 250, .94); font-size: 19rpx; text-align: center; }
.home-image-state.failed { color: #9d5147; background: #fff7f4; }
.inline-example-panel { margin-top: 14rpx; padding: 14rpx; border: 1rpx solid #ebe5dd; border-radius: 20rpx; background: #fffdfa; }
.inline-example-head { display: flex; justify-content: space-between; color: #4b453d; font-size: 20rpx; font-weight: 800; }
.inline-example-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10rpx; margin-top: 12rpx; }
.inline-example-tile { height: 180rpx; overflow: hidden; border-radius: 12rpx; background: #fff; }
.inline-example-tile image { display: block; width: 100%; height: 100%; object-fit: contain; }
.bottom-nav { bottom: calc(8rpx + env(safe-area-inset-bottom)); padding-bottom: 10rpx; }
.nav-item { flex: 1; min-width: 0; }

@media (max-width: 350px) {
  .illustration-grid { grid-template-columns: 1fr; }
  .illustration-card { height: 280rpx; }
}

/* Keep the three tabs visually centered inside their card, above the iPhone safe area. */
.app-shell.safe-bottom { padding-bottom: calc(156rpx + env(safe-area-inset-bottom)); }
.bottom-nav {
  height: 136rpx;
  align-items: center;
  padding: 8rpx;
}
.nav-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
}
.nav-icon {
  width: 52rpx;
  height: 52rpx;
  margin: 0 auto 6rpx;
  border-radius: 15rpx;
  font-size: 24rpx;
}
.nav-label {
  margin-top: 0;
  font-size: 20rpx;
  line-height: 1.2;
}

/* 图纸编辑仅改变预览视口，高清导出画布始终使用未缩放的完整网格。 */
.editor-viewport { position: relative; flex: 0 0 auto; width: 600rpx; height: 600rpx; overflow: hidden; border: 1rpx solid #d8d0c8; border-radius: 10rpx; background: #fffdfa; }
.result-edit-shortcut { flex: 0 0 auto; padding: 10rpx 16rpx; border: 1rpx solid #bdd7ec; border-radius: 12rpx; color: #2f6faf; background: #edf5ff; font-size: 19rpx; font-weight: 800; }
.editor-viewport .pattern-canvas { display: block; box-sizing: border-box; width: 600rpx; height: 600rpx; border: 0; transform-origin: 50% 50%; }
.editor-touch-layer { position: absolute; inset: 0; z-index: 2; width: 100%; height: 100%; }
.editor-toolbar { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 16rpx; }
.editor-tool, .editor-color-button { display: flex; align-items: center; justify-content: center; min-height: 58rpx; box-sizing: border-box; padding: 8rpx 14rpx; border: 1rpx solid #ded7d0; border-radius: 12rpx; color: #514940; background: #fffdfa; font-size: 21rpx; font-weight: 700; }
.editor-tool.active { border-color: #2f6faf; color: #2f6faf; background: #edf5ff; }
.editor-tool.muted { opacity: 0.38; }
.editor-color-button { flex: 1; justify-content: flex-start; min-width: 0; }
.editor-color-swatch { width: 27rpx; height: 27rpx; margin-right: 8rpx; border: 1rpx solid #b6ada4; border-radius: 5rpx; }
.editor-zoom-label { align-self: center; min-width: 56rpx; color: #726960; font-size: 19rpx; text-align: center; }
.editor-hint { margin-top: 10rpx; color: #8f8881; font-size: 18rpx; line-height: 1.5; }
.editor-history .editor-tool { flex: 1; }
.editor-save-actions { margin-bottom: 10rpx; }
.editor-palette-mask { position: fixed; inset: 0; z-index: 60; display: flex; align-items: flex-end; background: rgba(0, 0, 0, 0.42); }
.editor-palette-sheet { width: 100%; max-height: 72vh; box-sizing: border-box; padding: 22rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius: 24rpx 24rpx 0 0; background: #fffdfa; }
.editor-palette-head { display: flex; justify-content: space-between; align-items: center; color: #28231f; font-size: 25rpx; font-weight: 800; }
.editor-palette-head view:last-child { color: #2f6faf; }
.editor-palette-search { height: 64rpx; margin: 16rpx 0; padding: 0 18rpx; border: 1rpx solid #e7e0d8; border-radius: 12rpx; background: #f7f3ef; font-size: 22rpx; }
.editor-palette-scroll { height: 48vh; }
.editor-palette-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8rpx; }
.editor-palette-item { display: flex; align-items: center; flex-direction: column; gap: 5rpx; padding: 8rpx 0; border: 1rpx solid #e8e0d7; border-radius: 10rpx; font-size: 19rpx; }
.editor-palette-item.active { border-color: #2f6faf; background: #edf5ff; }
.editor-palette-swatch { width: 42rpx; height: 42rpx; border: 1rpx solid #c8beb5; border-radius: 7rpx; }
