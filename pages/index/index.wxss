  background: rgba(255, 255, 255, 0.12);
  font-size: 20rpx;
}

.member-note {
  color: rgba(255, 255, 255, 0.62);
  font-size: 20rpx;
}

.member-title {
  position: relative;
  z-index: 2;
  margin-top: 36rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
}

.member-description {
  position: relative;
  z-index: 2;
